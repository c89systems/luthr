set(LUTHR_TARGET "x86_64-linux-gnu" CACHE STRING "Selected target")
if(NOT LUTHR_TARGET MATCHES "^x86_64-linux-(gnu|musl)$")
  message(FATAL_ERROR "Initial Luthr development supports x86_64-linux-gnu and x86_64-linux-musl")
endif()
if(NOT CPKT_LIFECYCLE_SCRIPTS_DIR OR
    NOT EXISTS "${CPKT_LIFECYCLE_SCRIPTS_DIR}/cpkt-toolchains.sh")
  message(FATAL_ERROR "Set CPKT_LIFECYCLE_SCRIPTS_DIR to the activated lifecycle skill's scripts directory")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
  LUTHR_TARGET CPKT_LIFECYCLE_SCRIPTS_DIR)
execute_process(
  COMMAND "${CPKT_LIFECYCLE_SCRIPTS_DIR}/cpkt-toolchains.sh" discover "${LUTHR_TARGET}"
  RESULT_VARIABLE result OUTPUT_VARIABLE description ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT description MATCHES "(^|[\r\n])status=ready([\r\n]|$)")
  message(FATAL_ERROR "Pinned Bootlin collection unavailable: ${error}\nPrepare explicitly with: ${CPKT_LIFECYCLE_SCRIPTS_DIR}/cpkt-toolchains.sh ensure ${LUTHR_TARGET}")
endif()
foreach(key cc cxx ld ar ranlib strip nm objcopy objdump addr2line readelf sysroot root)
  string(REGEX MATCH "(^|[\r\n])${key}=([^\r\n]+)" match "${description}")
  if(NOT match)
    message(FATAL_ERROR "Bootlin resolver did not report ${key}")
  endif()
  set(bootlin_${key} "${CMAKE_MATCH_2}")
endforeach()
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER "${bootlin_cc}" CACHE FILEPATH "" FORCE)
set(CMAKE_ASM_COMPILER "${bootlin_cc}" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER "${bootlin_cxx}" CACHE FILEPATH "" FORCE)
set(CMAKE_LINKER "${bootlin_ld}" CACHE FILEPATH "" FORCE)
foreach(key ar ranlib strip nm objcopy objdump addr2line readelf)
  string(TOUPPER "${key}" upper)
  set(CMAKE_${upper} "${bootlin_${key}}" CACHE FILEPATH "" FORCE)
endforeach()
set(CMAKE_SYSROOT "${bootlin_sysroot}" CACHE PATH "" FORCE)
set(LUTHR_TOOLCHAIN_ROOT "${bootlin_root}")
set(LUTHR_BOOTLIN_READY ON)
list(PREPEND CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
list(REMOVE_DUPLICATES CMAKE_FIND_ROOT_PATH)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
