foreach(case IN ITEMS unlimited ancestor leaf rooted escaped legacy hybrid
    missing malformed zero_period no_mount no_cpu root)
  set(base "${CMAKE_CURRENT_BINARY_DIR}/capacity/${case}")
  set(mount "${base}/mount")
  if(case STREQUAL "escaped")
    set(mount "${base}/space root")
  endif()
  file(MAKE_DIRECTORY "${mount}/parent/child")
  string(REPLACE " " "\\040" encoded "${mount}")
  set(group "0::/parent/child\n")
  set(root "/")
  set(type cgroup2)
  set(options rw)
  set(expected unlimited)
  set(quota 0)
  set(period 0)
  file(WRITE "${mount}/cpu.max" "max 100000\n")
  file(WRITE "${mount}/parent/cpu.max" "max 100000\n")
  file(WRITE "${mount}/parent/child/cpu.max" "max 100000\n")
  if(case STREQUAL "ancestor")
    file(WRITE "${mount}/parent/cpu.max" "50000 100000\n")
    file(WRITE "${mount}/parent/child/cpu.max" "200000 100000\n")
    set(expected limited)
    set(quota 50000)
    set(period 100000)
  elseif(case STREQUAL "leaf")
    file(WRITE "${mount}/parent/cpu.max" "150000 100000\n")
    file(WRITE "${mount}/parent/child/cpu.max" "20000 100000\n")
    set(expected limited)
    set(quota 20000)
    set(period 100000)
  elseif(case STREQUAL "rooted")
    set(root "/tenant")
    set(group "0::/tenant/parent/child\n")
  elseif(case STREQUAL "legacy" OR case STREQUAL "hybrid")
    set(group "4:cpu,cpuacct:/parent/child\n")
    if(case STREQUAL "hybrid")
      string(APPEND group "0::/different/unified/group\n")
    endif()
    set(type cgroup)
    set(options "rw,cpu,cpuacct")
    foreach(directory IN ITEMS "${mount}" "${mount}/parent" "${mount}/parent/child")
      file(WRITE "${directory}/cpu.cfs_quota_us" "-1\n")
      file(WRITE "${directory}/cpu.cfs_period_us" "100000\n")
    endforeach()
    file(WRITE "${mount}/parent/cpu.cfs_quota_us" "25000\n")
    file(WRITE "${mount}/parent/cpu.cfs_period_us" "50000\n")
    file(WRITE "${mount}/parent/child/cpu.cfs_quota_us" "150000\n")
    set(expected limited)
    set(quota 25000)
    set(period 50000)
  elseif(case STREQUAL "missing")
    set(group "0::/not-present\n")
    set(expected unknown)
  elseif(case STREQUAL "malformed")
    file(WRITE "${mount}/parent/child/cpu.max" "broken 100000\n")
    set(expected unknown)
  elseif(case STREQUAL "zero_period")
    file(WRITE "${mount}/parent/child/cpu.max" "1000 0\n")
    set(expected unknown)
  elseif(case STREQUAL "no_mount")
    set(root "/tenant")
    set(group "0::/tenant2/parent/child\n")
    set(expected unknown)
  elseif(case STREQUAL "no_cpu")
    set(group "4:cpuset:/parent/child\n")
    set(expected unknown)
  elseif(case STREQUAL "root")
    set(group "0::/\n")
    file(REMOVE "${mount}/cpu.max")
  endif()
  file(WRITE "${base}/groups" "${group}")
  file(WRITE "${base}/mounts" "47 44 0:30 ${root} ${encoded} rw - ${type} cgroup ${options}\n")
  add_test(NAME cpu_capacity_${case} COMMAND cpu_capacity_test
    "${base}/groups" "${base}/mounts" "${expected}" "${quota}" "${period}")
  set_tests_properties(cpu_capacity_${case} PROPERTIES LABELS "benchmark;memcheck" TIMEOUT 10)
endforeach()
