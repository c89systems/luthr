foreach(module IN ITEMS lonejson libmdf)
  if(module STREQUAL "lonejson")
    set(version 0.50.0)
    set(source_tree lonejson-0.50.0)
  else()
    set(version 0.23.1)
    set(source_tree libmdf-lua-0.23.1)
  endif()
  set(check_dir "${build_dir}/module-input-checks/${module}")
  file(MAKE_DIRECTORY "${check_dir}/bad")
  file(READ "${source_dir}/.cache/modules/${source_tree}/VERSION" before)
  execute_process(COMMAND bash "${source_dir}/tests/modules/prepare.sh"
    "${check_dir}/missing" "${module}"
    RESULT_VARIABLE missing OUTPUT_QUIET ERROR_VARIABLE missing_error)
  if(NOT missing EQUAL 2 OR NOT missing_error MATCHES "Module archives missing")
    message(FATAL_ERROR "Missing module archives did not fail with preparation guidance")
  endif()
  file(STRINGS "${source_dir}/tests/modules/${module}-${version}.sha256" inputs)
  foreach(input IN LISTS inputs)
    string(REGEX REPLACE "^[a-f0-9]+  " "" name "${input}")
    file(WRITE "${check_dir}/bad/${name}" "incorrect archive\n")
  endforeach()
  execute_process(COMMAND bash "${source_dir}/tests/modules/prepare.sh"
    "${check_dir}/bad" "${module}" RESULT_VARIABLE mismatch
    OUTPUT_VARIABLE checks ERROR_QUIET)
  if(mismatch EQUAL 0 OR NOT checks MATCHES "FAILED")
    message(FATAL_ERROR "Incorrect module archive did not fail before extraction")
  endif()
  file(READ "${source_dir}/.cache/modules/${source_tree}/VERSION" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Failed module preparation changed the prepared inputs")
  endif()
endforeach()
execute_process(COMMAND bash "${source_dir}/tests/modules/prepare.sh"
  "${build_dir}/module-input-checks" unknown RESULT_VARIABLE unknown
  OUTPUT_QUIET ERROR_VARIABLE unknown_error)
if(NOT unknown EQUAL 2 OR NOT unknown_error MATCHES "Unknown acceptance module")
  message(FATAL_ERROR "Unknown acceptance module did not fail with guidance")
endif()
