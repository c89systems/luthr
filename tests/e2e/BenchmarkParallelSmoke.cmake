include("${CMAKE_CURRENT_LIST_DIR}/BenchmarkParallel.cmake")
file(STRINGS "${output_dir}/samples.csv" rows)
file(STRINGS "${output_dir}/summary.csv" summaries)
list(LENGTH rows raw_count)
list(LENGTH summaries summary_count)
if(NOT raw_count EQUAL 61 OR NOT summary_count EQUAL 21)
  message(FATAL_ERROR "Parallel benchmark lost samples or summaries")
endif()
list(REMOVE_AT summaries 0)
foreach(summary IN LISTS summaries)
  string(REPLACE "," ";" fields "${summary}")
  list(SUBLIST fields 0 3 key)
  string(JOIN "," key ${key})
  set(matching)
  foreach(row IN LISTS rows)
    string(FIND "${row}" "luthr,${key}," offset)
    if(offset EQUAL 0)
      list(APPEND matching "${row}")
    endif()
  endforeach()
  list(LENGTH matching count)
  if(NOT count EQUAL 2)
    message(FATAL_ERROR "Missing paired samples for ${key}")
  endif()
  list(GET matching 0 first)
  list(GET matching 1 second)
  string(REPLACE "," ";" first "${first}")
  string(REPLACE "," ";" second "${second}")
  foreach(column RANGE 6 24)
    math(EXPR source_column "${column} + 1")
    list(GET first ${source_column} a)
    list(GET second ${source_column} b)
    math(EXPR expected "(${a} + ${b}) / 2")
    list(GET fields ${column} actual)
    if(NOT actual EQUAL expected)
      message(FATAL_ERROR "Incorrect median for ${key}, column ${column}")
    endif()
  endforeach()
endforeach()
file(READ "${output_dir}/metadata.json" metadata)
foreach(key IN ITEMS script upstream luthr library)
  file(SHA256 "${${key}}" expected)
  string(JSON actual GET "${metadata}" "${key}_sha256")
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Wrong benchmark identity for ${key}")
  endif()
endforeach()
benchmark_median("9;1;3" median)
benchmark_ratio(7 3 ratio)
if(NOT median EQUAL 3 OR NOT ratio STREQUAL "2.333")
  message(FATAL_ERROR "Incorrect benchmark statistics")
endif()
benchmark_ratio(1 0 ratio)
if(NOT ratio STREQUAL "n/a")
  message(FATAL_ERROR "Zero denominator was not marked unavailable")
endif()
file(WRITE "${output_dir}/late-gc.lua"
  "return function() local t=setmetatable({}, {__gc=function() local start=os.clock(); while os.clock()-start<0.05 do end end}); return 1 end,function() collectgarbage('stop') end,function() end,1\n")
foreach(runtime IN ITEMS upstream luthr)
  execute_process(COMMAND "${${runtime}}" "${output_dir}/late-gc.lua" late_gc
    incremental 1 1 1 1 0 RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result STREQUAL "0" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Parallel final collection failed: ${runtime}: ${result}: ${output}${error}")
  endif()
  string(STRIP "${output}" output)
  string(REPLACE "," ";" fields "${output}")
  list(GET fields 3 elapsed)
  if(elapsed LESS 40000000)
    message(FATAL_ERROR "Parallel total excluded the finalizer delay: ${runtime}")
  endif()
endforeach()
