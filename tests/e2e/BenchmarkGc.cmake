include("${CMAKE_CURRENT_LIST_DIR}/BenchmarkStats.cmake")
foreach(setting IN ITEMS samples warmups tasks work_divisor)
  if(NOT DEFINED ${setting})
    if(setting STREQUAL "samples")
      set(${setting} 5)
    elseif(setting STREQUAL "warmups")
      set(${setting} 2)
    elseif(setting STREQUAL "tasks")
      set(${setting} 32)
    else()
      set(${setting} 1)
    endif()
  endif()
  if(NOT "${${setting}}" MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid GC benchmark ${setting}")
  endif()
endforeach()
if(samples LESS 1 OR samples GREATER 1000 OR warmups GREATER 1000 OR
    tasks LESS 1 OR tasks GREATER 4096 OR work_divisor LESS 1)
  message(FATAL_ERROR "GC benchmark settings outside supported bounds")
endif()
execute_process(COMMAND "${control}" --capacity RESULT_VARIABLE result
  OUTPUT_VARIABLE capacity ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result STREQUAL "0" OR NOT error STREQUAL "")
  message(FATAL_ERROR "Cannot read GC benchmark capacity: ${result}: ${error}")
endif()
string(JSON effective GET "${capacity}" effective_cpu_milli)
math(EXPR maximum "(${effective} + 999) / 1000")
if(maximum LESS 1)
  set(maximum 1)
endif()
if(NOT DEFINED levels)
  set(levels 1)
  foreach(width IN ITEMS 2 4 8)
    if(width LESS_EQUAL maximum AND width LESS_EQUAL tasks)
      list(APPEND levels "${width}")
    endif()
  endforeach()
endif()
foreach(width IN LISTS levels)
  if(NOT "${width}" MATCHES "^[1-9][0-9]*$" OR width GREATER 64)
    message(FATAL_ERROR "GC benchmark slots must be 1..64")
  endif()
endforeach()
if(NOT 1 IN_LIST levels)
  message(FATAL_ERROR "GC benchmark needs a single-slot baseline")
endif()
file(MAKE_DIRECTORY "${output_dir}")
set(metrics wall_ns cpu_ns lua_peak_bytes lua_retained_bytes threads)
set(probes stop_requests stop_gc stop_barrier stop_other collector_calls
  collector_running_calls collector_body_ns collector_disabled_ns coordination_ns
  stop_request_ns resume_ns heap_entries heap_gc_entries heap_contended_entries
  stopped_ns trace_calls trace_ns trace_scan_ns trace_work_bytes trace_assist_calls trace_cycles
  mark_peak_bytes sweep_peak_bytes reclaim_peak_bytes idle_peak_bytes trace_peak_workers
  trace_waits trace_wait_ns root_snapshot_calls root_snapshot_ns
  heap_gc_wait_ns quiesce_waits quiesce_wait_ns metadata_waits metadata_wait_ns
  mutator_stop_waits mutator_stop_wait_ns publish_calls publish_ns drain_calls
  drain_ns barrier_records back_records repeated_back_records reclaim_calls
  reclaim_ns object_reclaim_calls object_reclaim_ns reclaim_assist_calls
  reclaim_waits reclaim_wait_ns inspection_ns)
string(JOIN ",gc_" probe_columns ${probes})
string(JOIN "," metric_columns ${metrics})
file(WRITE "${output_dir}/summary.csv"
  "runtime,workload,collector,automatic_gc,slots,tasks,iterations,${metric_columns},gc_${probe_columns}\n")
set(metadata "{}")
foreach(key IN ITEMS target config compiler samples warmups tasks work_divisor)
  string(JSON metadata SET "${metadata}" "${key}" "\"${${key}}\"")
endforeach()
string(JSON metadata SET "${metadata}" capacity "${capacity}")
string(JSON metadata SET "${metadata}" notes
  "\"Counters are invocation-local wall durations. Coordination includes nested waits/publication/drain. Wait sums can exceed elapsed time. Collector body includes object destruction and trace assists, excludes coordination and page reclamation, and can include scheduler suspension. Trace batches exclude cooperative suspension; roots are measured separately. Stopped time starts after quiescence and ends before resumed root work. Object reclamation is a subset of collector body, including work after collection calls return. Stopped disables automatic collection; explicit steps still run. Compare wrapped profile with identical unwrapped static control for probe overhead.\"")
foreach(input IN ITEMS upstream shared control profile library script)
  file(SHA256 "${${input}}" digest)
  string(JSON metadata SET "${metadata}" "${input}_sha256" "\"${digest}\"")
endforeach()
execute_process(COMMAND git -C "${source_dir}" rev-parse HEAD
  RESULT_VARIABLE result OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Cannot identify GC benchmark revision")
endif()
string(JSON metadata SET "${metadata}" git_head "\"${head}\"")
execute_process(COMMAND git -C "${source_dir}" status --porcelain
  RESULT_VARIABLE result OUTPUT_VARIABLE dirty)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Cannot identify GC benchmark worktree")
endif()
if(dirty STREQUAL "")
  string(JSON metadata SET "${metadata}" git_dirty false)
else()
  string(JSON metadata SET "${metadata}" git_dirty true)
endif()
file(WRITE "${output_dir}/metadata.json" "${metadata}\n")
set(integers_iterations 500000)
set(independent_tables_iterations 5000)
set(allocation_only_iterations 5000)
set(gc_profile_paths)
foreach(workload IN ITEMS integers independent_tables allocation_only)
  math(EXPR iterations "${${workload}_iterations} / ${work_divisor}")
  if(iterations LESS 1)
    set(iterations 1)
  endif()
  unset(reference_checksum)
  foreach(collector IN ITEMS incremental generational)
    foreach(automatic_gc IN ITEMS running stopped)
      set(extra)
      if(automatic_gc STREQUAL "stopped")
        set(extra stopped)
      endif()
      foreach(runtime IN ITEMS upstream shared control profile)
        set(widths ${levels})
        set(native 1)
        if(runtime STREQUAL "upstream")
          set(widths 1)
          set(native 0)
        endif()
        foreach(width IN LISTS widths)
          execute_process(COMMAND "${${runtime}}" "${script}" "${workload}"
            "${collector}" "${width}" "${native}" "${tasks}" "${iterations}"
            "${samples}" "${warmups}" 0 ${extra}
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
          if(NOT result STREQUAL "0" OR NOT error STREQUAL "")
            message(FATAL_ERROR "GC benchmark failed: ${runtime}/${workload}/${collector}/${automatic_gc}/${width}: ${result}: ${output}${error}")
          endif()
          set(name "${runtime}-${workload}-${collector}-${automatic_gc}-${width}")
          file(WRITE "${output_dir}/${name}.jsonl" "${output}")
          if(runtime STREQUAL "profile")
            list(APPEND gc_profile_paths "${output_dir}/${name}.jsonl")
          endif()
          string(STRIP "${output}" output)
          string(REPLACE "\n" ";" rows "${output}")
          list(LENGTH rows count)
          if(NOT count EQUAL samples)
            message(FATAL_ERROR "Expected ${samples} GC samples, received ${count}")
          endif()
          set(all_metrics ${metrics})
          if(runtime STREQUAL "profile")
            foreach(probe IN LISTS probes)
              list(APPEND all_metrics "gc_${probe}")
            endforeach()
          endif()
          foreach(metric IN LISTS all_metrics)
            set(values_${metric})
          endforeach()
          foreach(row IN LISTS rows)
            string(JSON checksum GET "${row}" checksum)
            string(JSON completed GET "${row}" completed)
            if(NOT DEFINED reference_checksum)
              set(reference_checksum "${checksum}")
            endif()
            if(NOT checksum STREQUAL reference_checksum OR NOT completed EQUAL tasks)
              message(FATAL_ERROR "GC comparison changed the result: ${name}")
            endif()
            foreach(metric IN LISTS all_metrics)
              string(JSON value GET "${row}" "${metric}")
              if(NOT value MATCHES "^[0-9]+$")
                message(FATAL_ERROR "Invalid GC metric: ${name}: ${metric}")
              endif()
              list(APPEND values_${metric} "${value}")
            endforeach()
            if(runtime STREQUAL "profile" AND automatic_gc STREQUAL "stopped")
              string(JSON running GET "${row}" gc_collector_running_calls)
              string(JSON body GET "${row}" gc_collector_body_ns)
              if(NOT running EQUAL 0 OR NOT body EQUAL 0)
                message(FATAL_ERROR "Stopped control executed collector work: ${name}")
              endif()
            endif()
          endforeach()
          set(medians)
          foreach(metric IN LISTS metrics)
            benchmark_median("${values_${metric}}" median)
            list(APPEND medians "${median}")
          endforeach()
          foreach(probe IN LISTS probes)
            if(runtime STREQUAL "profile")
              benchmark_median("${values_gc_${probe}}" median)
            else()
              set(median "n/a")
            endif()
            list(APPEND medians "${median}")
          endforeach()
          string(JOIN "," medians ${medians})
          file(APPEND "${output_dir}/summary.csv"
            "${runtime},${workload},${collector},${automatic_gc},${width},${tasks},${iterations},${medians}\n")
          message(STATUS "GC ${name}: ${samples} samples")
        endforeach()
      endforeach()
    endforeach()
  endforeach()
endforeach()
message(STATUS "GC controls, counters and raw samples saved under ${output_dir}")
