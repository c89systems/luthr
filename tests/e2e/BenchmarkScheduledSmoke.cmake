include("${CMAKE_CURRENT_LIST_DIR}/BenchmarkScheduled.cmake")
file(STRINGS "${output_dir}/samples.csv" rows)
file(STRINGS "${output_dir}/summary.csv" summaries)
list(LENGTH rows raw_count)
list(LENGTH summaries summary_count)
if(NOT raw_count EQUAL 769 OR NOT summary_count EQUAL 385)
  message(FATAL_ERROR "Scheduler benchmark lost a configuration or sample")
endif()
list(REMOVE_AT summaries 0)
set(embeddings)
list(LENGTH metrics metric_count)
math(EXPR last_metric "8 + ${metric_count}")
foreach(summary IN LISTS summaries)
  string(REPLACE "," ";" fields "${summary}")
  list(SUBLIST fields 0 8 key)
  string(JOIN "," key ${key})
  if(key MATCHES "^embedded,")
    list(APPEND embeddings "${key}")
  endif()
  set(matching)
  foreach(row IN LISTS rows)
    string(FIND "${row}" "${key}," offset)
    if(offset EQUAL 0)
      list(APPEND matching "${row}")
    endif()
  endforeach()
  list(LENGTH matching count)
  if(NOT count EQUAL 2)
    message(FATAL_ERROR "Missing paired scheduler samples for ${key}")
  endif()
  list(GET matching 0 first)
  list(GET matching 1 second)
  string(REPLACE "," ";" first "${first}")
  string(REPLACE "," ";" second "${second}")
  foreach(column RANGE 9 ${last_metric})
    list(GET first ${column} a)
    list(GET second ${column} b)
    math(EXPR expected "(${a} + ${b}) / 2")
    list(GET fields ${column} actual)
    if(NOT actual EQUAL expected)
      message(FATAL_ERROR "Incorrect scheduler median for ${key}, column ${column}")
    endif()
  endforeach()
endforeach()
foreach(workload IN LISTS native_workloads)
  math(EXPR expected_iterations "${${workload}_iterations} / ${work_divisor}")
  if(expected_iterations LESS 1)
    set(expected_iterations 1)
  endif()
  foreach(collector IN ITEMS incremental generational)
    foreach(delay IN ITEMS 0 "${delay_us}")
      set(expected "embedded,${workload},${collector},1,0,8,${expected_iterations},${delay}")
      if(NOT expected IN_LIST embeddings)
        message(FATAL_ERROR "Missing embedded callback comparison: ${expected}")
      endif()
    endforeach()
  endforeach()
endforeach()
list(LENGTH embeddings count)
if(NOT count EQUAL 32)
  message(FATAL_ERROR "Unexpected embedded benchmark configuration")
endif()
file(READ "${output_dir}/metadata.json" metadata)
foreach(input IN ITEMS upstream luthr embedded library script)
  file(SHA256 "${${input}}" expected)
  string(JSON actual GET "${metadata}" "${input}_sha256")
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Incorrect scheduler input identity: ${input}")
  endif()
endforeach()
string(JSON model GET "${metadata}" model)
if(NOT model STREQUAL "public_task_scheduler")
  message(FATAL_ERROR "Scheduler benchmark identified the wrong execution model")
endif()
