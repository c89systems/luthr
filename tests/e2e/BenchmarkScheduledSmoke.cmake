include("${CMAKE_CURRENT_LIST_DIR}/BenchmarkScheduled.cmake")
file(STRINGS "${output_dir}/samples.csv" rows)
file(STRINGS "${output_dir}/summary.csv" summaries)
list(LENGTH rows raw_count)
list(LENGTH summaries summary_count)
list(LENGTH lua_applications application_count)
math(EXPR expected_summaries "585 + 10 * ${application_count}")
math(EXPR expected_raw "1 + (${expected_summaries} - 1) * ${samples}")
if(NOT raw_count EQUAL expected_raw OR NOT summary_count EQUAL expected_summaries)
  message(FATAL_ERROR "Scheduler benchmark lost a configuration or sample")
endif()
list(REMOVE_AT summaries 0)
set(embeddings)
list(LENGTH metrics metric_count)
math(EXPR last_metric "8 + ${metric_count}")
list(FIND metrics execution_cpu_ns cpu_metric)
math(EXPR execution_cpu_column "9 + ${cpu_metric}")
math(EXPR reference_cpu_column "${last_metric} + 4")
math(EXPR cpu_ratio_column "${reference_cpu_column} + 1")
foreach(summary IN LISTS summaries)
  string(REPLACE "," ";" fields "${summary}")
  list(SUBLIST fields 0 8 key)
  string(JOIN "," key ${key})
  if(key MATCHES "^embedded,")
    list(APPEND embeddings "${key}")
  endif()
  set(matching)
  foreach(row IN LISTS rows)
    string(FIND "${row}" "${key}," offset)
    if(offset EQUAL 0)
      list(APPEND matching "${row}")
    endif()
  endforeach()
  list(LENGTH matching count)
  if(NOT count EQUAL 2)
    message(FATAL_ERROR "Missing paired scheduler samples for ${key}")
  endif()
  list(GET matching 0 first)
  list(GET matching 1 second)
  string(REPLACE "," ";" first "${first}")
  string(REPLACE "," ";" second "${second}")
  foreach(column RANGE 9 ${last_metric})
    list(GET first ${column} a)
    list(GET second ${column} b)
    math(EXPR expected "(${a} + ${b}) / 2")
    list(GET fields ${column} actual)
    if(NOT actual EQUAL expected)
      message(FATAL_ERROR "Incorrect scheduler median for ${key}, column ${column}")
    endif()
  endforeach()
  list(GET fields ${execution_cpu_column} execution_cpu)
  list(GET fields ${reference_cpu_column} reference_cpu)
  list(GET fields ${cpu_ratio_column} cpu_ratio)
  benchmark_ratio("${execution_cpu}" "${reference_cpu}" expected_ratio)
  if(NOT cpu_ratio STREQUAL expected_ratio)
    message(FATAL_ERROR "Incorrect scheduler execution CPU ratio for ${key}")
  endif()
  list(GET fields 1 case_workload)
  list(GET fields 2 case_collector)
  list(GET fields 7 case_delay)
  set(cpu_key "${case_workload}_${case_collector}_${case_delay}")
  if(key MATCHES "^upstream,")
    set(upstream_cpu_${cpu_key} "${execution_cpu}")
  endif()
  if(NOT reference_cpu EQUAL upstream_cpu_${cpu_key})
    message(FATAL_ERROR "CPU reference differs from the matched upstream run for ${key}")
  endif()
endforeach()
foreach(workload IN LISTS embedded_workloads)
  math(EXPR expected_iterations "${${workload}_iterations} / ${work_divisor}")
  if(expected_iterations LESS 1)
    set(expected_iterations 1)
  endif()
  set(delays 0 "${delay_us}")
  if(workload IN_LIST lua_applications)
    set(delays 0)
  endif()
  foreach(collector IN ITEMS incremental generational)
    foreach(delay IN LISTS delays)
      set(expected "embedded,${workload},${collector},1,0,8,${expected_iterations},${delay}")
      if(NOT expected IN_LIST embeddings)
        message(FATAL_ERROR "Missing embedded comparison: ${expected}")
      endif()
    endforeach()
  endforeach()
endforeach()
list(LENGTH embeddings count)
math(EXPR expected_embeddings "56 + 2 * ${application_count}")
if(NOT count EQUAL expected_embeddings)
  message(FATAL_ERROR "Unexpected embedded benchmark configuration")
endif()
file(READ "${output_dir}/metadata.json" metadata)
string(JSON gc_mode GET "${metadata}" automatic_gc)
if(NOT gc_mode STREQUAL "running")
  message(FATAL_ERROR "Scheduler smoke benchmark must keep automatic collection enabled")
endif()
foreach(input IN ITEMS upstream luthr embedded library script)
  file(SHA256 "${${input}}" expected)
  string(JSON actual GET "${metadata}" "${input}_sha256")
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Incorrect scheduler input identity: ${input}")
  endif()
endforeach()
foreach(application IN LISTS lua_applications)
  file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/apps/${application}.lua" expected)
  string(JSON actual GET "${metadata}" "${application}_sha256")
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Incorrect Lua application benchmark input identity: ${application}")
  endif()
endforeach()
string(JSON model GET "${metadata}" model)
if(NOT model STREQUAL "public_task_scheduler")
  message(FATAL_ERROR "Scheduler benchmark identified the wrong execution model")
endif()
string(JSON allocator GET "${metadata}" allocator)
if(NOT allocator STREQUAL "default")
  message(FATAL_ERROR "Scheduler benchmark identified the wrong allocator")
endif()
string(JSON seed GET "${metadata}" hash_seed)
if(NOT seed EQUAL 21)
  message(FATAL_ERROR "Scheduler benchmark recorded the wrong hash seed")
endif()
