function(benchmark_ratio numerator denominator result)
  if(denominator EQUAL 0)
    set(${result} "n/a" PARENT_SCOPE)
    return()
  endif()
  math(EXPR scaled "${numerator} * 1000 / ${denominator}")
  math(EXPR whole "${scaled} / 1000")
  math(EXPR fraction "${scaled} % 1000")
  set(fraction "000${fraction}")
  string(LENGTH "${fraction}" length)
  math(EXPR offset "${length} - 3")
  string(SUBSTRING "${fraction}" ${offset} 3 fraction)
  set(${result} "${whole}.${fraction}" PARENT_SCOPE)
endfunction()

function(benchmark_median values result)
  list(SORT values COMPARE NATURAL)
  list(LENGTH values count)
  math(EXPR middle "${count} / 2")
  list(GET values ${middle} median)
  math(EXPR even "${count} % 2")
  if(even EQUAL 0)
    math(EXPR lower "${middle} - 1")
    list(GET values ${lower} previous)
    math(EXPR median "(${median} + ${previous}) / 2")
  endif()
  set(${result} "${median}" PARENT_SCOPE)
endfunction()
