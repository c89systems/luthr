file(MAKE_DIRECTORY "${work_dir}")
file(WRITE "${work_dir}/error.lua"
  "return function() error('intentional job failure') end,function() end,function() end,1\n")
file(WRITE "${work_dir}/nonstring.lua"
  "return function() error({}) end,function() end,function() end,1\n")
foreach(runtime IN ITEMS upstream luthr embedded)
  foreach(case IN ITEMS zero unknown missing runtime nonstring unknown_option
      duplicate_option invalid_seed overflowing_seed duplicate_seed)
    set(source "${script}")
    set(workload integers)
    set(tasks 8)
    set(expected 1)
    set(options)
    if(case STREQUAL "zero")
      set(tasks 0)
      set(expected 2)
      set(diagnostic "usage:")
    elseif(case STREQUAL "unknown")
      set(workload unknown)
      set(diagnostic "unknown workload")
    elseif(case STREQUAL "missing")
      set(source "${work_dir}/absent.lua")
      set(diagnostic "benchmark source:")
    elseif(case STREQUAL "nonstring")
      set(source "${work_dir}/nonstring.lua")
      set(diagnostic "non-string Lua error")
    elseif(case MATCHES "^(unknown_option|duplicate_option|invalid_seed|overflowing_seed|duplicate_seed)$")
      if(case STREQUAL "unknown_option")
        set(options unknown)
      elseif(case STREQUAL "duplicate_option")
        set(options default-allocator default-allocator)
      elseif(case STREQUAL "invalid_seed")
        set(options hash-seed=-1)
      elseif(case STREQUAL "overflowing_seed")
        set(options hash-seed=4294967296)
      else()
        set(options hash-seed=0 hash-seed=1)
      endif()
      set(expected 2)
      set(diagnostic "usage:")
    else()
      set(source "${work_dir}/error.lua")
      set(diagnostic "intentional job failure")
    endif()
    execute_process(COMMAND "${${runtime}}" "${source}" "${workload}" incremental
      1 0 "${tasks}" 128 1 0 0 ${options} RESULT_VARIABLE result
      OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT result STREQUAL "${expected}" OR NOT output STREQUAL "" OR NOT error MATCHES "${diagnostic}")
      message(FATAL_ERROR "Incorrect scheduled ${runtime}/${case} failure: ${result}\n${output}${error}")
    endif()
  endforeach()
  execute_process(COMMAND "${${runtime}}" "${script}" integers incremental
    1 0 8 128 1 0 0 stopped default-allocator hash-seed=4294967295
    RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
  if(NOT result STREQUAL "0" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Default allocator with GC stopped failed: ${runtime}: ${result}\n${output}${error}")
  endif()
  string(JSON allocator GET "${output}" allocator)
  string(JSON stopped GET "${output}" automatic_gc_stopped)
  string(JSON heap_peak TYPE "${output}" lua_peak_bytes)
  string(JSON seed GET "${output}" hash_seed)
  if(NOT allocator STREQUAL "default" OR NOT stopped EQUAL 1 OR
      NOT heap_peak STREQUAL "NULL" OR NOT seed EQUAL 4294967295)
    message(FATAL_ERROR "Incorrect default allocator sample: ${runtime}: ${output}")
  endif()
endforeach()
foreach(runtime IN ITEMS upstream embedded)
  execute_process(COMMAND "${${runtime}}" "${script}" integers incremental 2 0 8 128 1 0 0
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result STREQUAL "2" OR NOT output STREQUAL "" OR NOT error MATCHES "requires slots=1")
    message(FATAL_ERROR "Serial host admitted parallel scheduling: ${runtime}: ${result}\n${output}${error}")
  endif()
endforeach()
