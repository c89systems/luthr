file(MAKE_DIRECTORY "${work_dir}")
file(WRITE "${work_dir}/error.lua"
  "return function() error('intentional job failure') end,function() end,function() end,1\n")
file(WRITE "${work_dir}/nonstring.lua"
  "return function() error({}) end,function() end,function() end,1\n")
foreach(runtime IN ITEMS upstream luthr)
  foreach(case IN ITEMS zero unknown missing runtime nonstring)
    set(source "${script}")
    set(workload integers)
    set(tasks 8)
    set(expected 1)
    if(case STREQUAL "zero")
      set(tasks 0)
      set(expected 2)
      set(diagnostic "usage:")
    elseif(case STREQUAL "unknown")
      set(workload unknown)
      set(diagnostic "unknown workload")
    elseif(case STREQUAL "missing")
      set(source "${work_dir}/absent.lua")
      set(diagnostic "benchmark source:")
    elseif(case STREQUAL "nonstring")
      set(source "${work_dir}/nonstring.lua")
      set(diagnostic "non-string Lua error")
    else()
      set(source "${work_dir}/error.lua")
      set(diagnostic "intentional job failure")
    endif()
    execute_process(COMMAND "${${runtime}}" "${source}" "${workload}" incremental
      1 0 "${tasks}" 128 1 0 0 RESULT_VARIABLE result
      OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT result STREQUAL "${expected}" OR NOT output STREQUAL "" OR NOT error MATCHES "${diagnostic}")
      message(FATAL_ERROR "Incorrect scheduled ${runtime}/${case} failure: ${result}\n${output}${error}")
    endif()
  endforeach()
endforeach()
execute_process(COMMAND "${upstream}" "${script}" integers incremental 2 0 8 128 1 0 0
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result STREQUAL "2" OR NOT output STREQUAL "" OR NOT error MATCHES "requires slots=1")
  message(FATAL_ERROR "Upstream admitted parallel scheduling: ${result}\n${output}${error}")
endif()
