include("${CMAKE_CURRENT_LIST_DIR}/BenchmarkStats.cmake")
if(NOT DEFINED samples)
  set(samples 5)
endif()
if(NOT DEFINED warmups)
  set(warmups 2)
endif()
if(NOT DEFINED work_divisor)
  set(work_divisor 1)
endif()
if(NOT samples MATCHES "^[1-9][0-9]*$" OR NOT warmups MATCHES "^[0-9]+$"
    OR NOT work_divisor MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "Invalid benchmark sample/warmup/work settings")
endif()
file(MAKE_DIRECTORY "${output_dir}")
set(raw "${output_dir}/samples.csv")
set(summary "${output_dir}/summary.csv")
file(WRITE "${raw}" "runtime,workload,collector,repetitions,sample,checksum,cpu_ns,wall_ns\n")
file(WRITE "${summary}" "workload,collector,repetitions,samples,upstream_cpu_ns,luthr_cpu_ns,cpu_ratio,upstream_wall_ns,luthr_wall_ns,wall_ratio\n")
string(TIMESTAMP started "%Y-%m-%dT%H:%M:%SZ" UTC)
file(WRITE "${output_dir}/metadata.json"
  "{\"lua\":\"5.5.1\",\"target\":\"${target}\",\"config\":\"${config}\",\"compiler\":\"${compiler}\",\"started_utc\":\"${started}\",\"samples\":${samples},\"warmups\":${warmups},\"work_divisor\":${work_divisor},\"hash_seed\":0,\"ratio\":\"luthr/upstream\",\"timing_unit\":\"ns\",\"timing\":\"includes final collection\"}\n")
set(integers_repetitions 25)
set(tables_repetitions 20)
set(closures_repetitions 50)
set(strings_repetitions 20)
set(floating_point_repetitions 35)
set(metamethods_repetitions 20)
set(coroutines_repetitions 20)
set(protected_calls_repetitions 20)
set(load_chunks_repetitions 12)
set(utf8_binary_repetitions 15)
set(buffered_io_repetitions 12)
set(math_library_repetitions 20)
set(module_loading_repetitions 12)
set(calendar_repetitions 12)
set(debug_hooks_repetitions 12)
set(allocation_gc_repetitions 20)
set(native_callbacks_repetitions 100)
set(streaming_repetitions 100)
set(comparison "Single-worker wall time: Luthr / upstream Lua 5.5.1\n")
string(APPEND comparison "${target} ${config}; ${samples} measured samples (median), ${warmups} warmups\n")
string(APPEND comparison "1.000x = equal time; larger values mean Luthr takes longer.\n\n")
string(APPEND comparison "Workload            Incremental  Generational\n")
set(lua_benchmark_workloads integers floating_point tables closures strings metamethods
  coroutines protected_calls load_chunks utf8_binary buffered_io math_library
  module_loading calendar debug_hooks allocation_gc native_callbacks streaming)
foreach(workload IN LISTS lua_benchmark_workloads)
  set(repetitions "${${workload}_repetitions}")
  foreach(collector IN ITEMS incremental generational)
    foreach(runtime IN ITEMS upstream luthr)
      execute_process(COMMAND "${${runtime}}" "${script}" "${module_dir}"
        "${workload}" "${collector}" "${samples}" "${warmups}" "${work_divisor}" "${repetitions}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
      if(NOT result EQUAL 0 OR NOT error STREQUAL "")
        message(FATAL_ERROR "Benchmark failed: ${runtime}/${workload}/${collector} (${result})\n${output}${error}")
      endif()
      string(STRIP "${output}" output)
      string(REPLACE "\n" ";" rows "${output}")
      list(LENGTH rows row_count)
      if(NOT row_count EQUAL samples)
        message(FATAL_ERROR "Benchmark returned ${row_count} rows, expected ${samples}")
      endif()
      set(cpus)
      set(walls)
      set(checksum "")
      foreach(row IN LISTS rows)
        if(NOT row MATCHES "^[0-9]+,([0-9]+),([0-9]+),([0-9]+)$")
          message(FATAL_ERROR "Invalid benchmark row: ${row}")
        endif()
        if(NOT checksum STREQUAL "" AND NOT checksum STREQUAL CMAKE_MATCH_1)
          message(FATAL_ERROR "Benchmark changed its result between samples")
        endif()
        set(checksum "${CMAKE_MATCH_1}")
        list(APPEND cpus "${CMAKE_MATCH_2}")
        list(APPEND walls "${CMAKE_MATCH_3}")
        file(APPEND "${raw}" "${runtime},${workload},${collector},${repetitions},${row}\n")
      endforeach()
      benchmark_median("${cpus}" ${runtime}_cpu)
      benchmark_median("${walls}" ${runtime}_wall)
      set(${runtime}_checksum "${checksum}")
    endforeach()
    if(NOT upstream_checksum STREQUAL luthr_checksum)
      message(FATAL_ERROR "Benchmark result differs between upstream and Luthr")
    endif()
    benchmark_ratio("${luthr_cpu}" "${upstream_cpu}" cpu_ratio)
    benchmark_ratio("${luthr_wall}" "${upstream_wall}" wall_ratio)
    set(row "${workload},${collector},${repetitions},${samples},${upstream_cpu},${luthr_cpu},${cpu_ratio},${upstream_wall},${luthr_wall},${wall_ratio}")
    file(APPEND "${summary}" "${row}\n")
    set(wall_ratio_${collector} "${wall_ratio}")
    message(STATUS "${workload}/${collector}: ${wall_ratio}x upstream wall time")
  endforeach()
  string(LENGTH "${workload}" name_length)
  math(EXPR padding "20 - ${name_length}")
  string(REPEAT " " ${padding} padding)
  string(APPEND comparison "${workload}${padding}${wall_ratio_incremental}x       ${wall_ratio_generational}x\n")
endforeach()
file(WRITE "${output_dir}/comparison.txt" "${comparison}")
message(STATUS "\n${comparison}")
message(STATUS "Comparison: ${output_dir}/comparison.txt\nRaw samples: ${raw}\nCPU/wall medians: ${summary}")
