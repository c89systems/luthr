if(NOT DEFINED samples)
  set(samples 5)
endif()
if(NOT DEFINED warmups)
  set(warmups 2)
endif()
if(NOT DEFINED work_divisor)
  set(work_divisor 1)
endif()
if(NOT samples MATCHES "^[1-9][0-9]*$" OR NOT warmups MATCHES "^[0-9]+$"
    OR NOT work_divisor MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "Invalid benchmark sample/warmup/work settings")
endif()
file(MAKE_DIRECTORY "${output_dir}")
set(raw "${output_dir}/samples.csv")
set(summary "${output_dir}/summary.csv")
file(WRITE "${raw}" "runtime,workload,collector,repetitions,sample,checksum,cpu_ns,wall_ns\n")
file(WRITE "${summary}" "workload,collector,repetitions,samples,upstream_cpu_ns,luthrum_cpu_ns,cpu_ratio,upstream_wall_ns,luthrum_wall_ns,wall_ratio\n")
string(TIMESTAMP started "%Y-%m-%dT%H:%M:%SZ" UTC)
file(WRITE "${output_dir}/metadata.json"
  "{\"lua\":\"5.5.1\",\"target\":\"${target}\",\"config\":\"${config}\",\"compiler\":\"${compiler}\",\"started_utc\":\"${started}\",\"samples\":${samples},\"warmups\":${warmups},\"work_divisor\":${work_divisor},\"ratio\":\"luthrum/upstream\",\"timing_unit\":\"ns\"}\n")
function(ratio numerator denominator result)
  if(denominator EQUAL 0)
    set(${result} "n/a" PARENT_SCOPE)
    return()
  endif()
  math(EXPR scaled "${numerator} * 1000 / ${denominator}")
  math(EXPR whole "${scaled} / 1000")
  math(EXPR fraction "${scaled} % 1000")
  set(fraction "000${fraction}")
  string(LENGTH "${fraction}" length)
  math(EXPR offset "${length} - 3")
  string(SUBSTRING "${fraction}" ${offset} 3 fraction)
  set(${result} "${whole}.${fraction}" PARENT_SCOPE)
endfunction()
set(integers_repetitions 25)
set(tables_repetitions 20)
set(closures_repetitions 50)
set(strings_repetitions 20)
set(allocation_gc_repetitions 20)
set(native_callbacks_repetitions 100)
set(streaming_repetitions 100)
foreach(workload IN ITEMS integers tables closures strings allocation_gc native_callbacks streaming)
  set(repetitions "${${workload}_repetitions}")
  foreach(collector IN ITEMS incremental generational)
    foreach(runtime IN ITEMS upstream luthrum)
      execute_process(COMMAND "${${runtime}}" "${script}" "${module_dir}"
        "${workload}" "${collector}" "${samples}" "${warmups}" "${work_divisor}" "${repetitions}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
      if(NOT result EQUAL 0 OR NOT error STREQUAL "")
        message(FATAL_ERROR "Benchmark failed: ${runtime}/${workload}/${collector} (${result})\n${output}${error}")
      endif()
      string(STRIP "${output}" output)
      string(REPLACE "\n" ";" rows "${output}")
      list(LENGTH rows row_count)
      if(NOT row_count EQUAL samples)
        message(FATAL_ERROR "Benchmark returned ${row_count} rows, expected ${samples}")
      endif()
      set(cpus)
      set(walls)
      set(checksum "")
      foreach(row IN LISTS rows)
        if(NOT row MATCHES "^[0-9]+,([0-9]+),([0-9]+),([0-9]+)$")
          message(FATAL_ERROR "Invalid benchmark row: ${row}")
        endif()
        if(NOT checksum STREQUAL "" AND NOT checksum STREQUAL CMAKE_MATCH_1)
          message(FATAL_ERROR "Benchmark changed its result between samples")
        endif()
        set(checksum "${CMAKE_MATCH_1}")
        list(APPEND cpus "${CMAKE_MATCH_2}")
        list(APPEND walls "${CMAKE_MATCH_3}")
        file(APPEND "${raw}" "${runtime},${workload},${collector},${repetitions},${row}\n")
      endforeach()
      list(SORT cpus COMPARE NATURAL)
      list(SORT walls COMPARE NATURAL)
      math(EXPR middle "${samples} / 2")
      list(GET cpus ${middle} ${runtime}_cpu)
      list(GET walls ${middle} ${runtime}_wall)
      math(EXPR even "${samples} % 2")
      if(even EQUAL 0)
        math(EXPR lower "${middle} - 1")
        list(GET cpus ${lower} lower_cpu)
        list(GET walls ${lower} lower_wall)
        math(EXPR ${runtime}_cpu "(${${runtime}_cpu} + ${lower_cpu}) / 2")
        math(EXPR ${runtime}_wall "(${${runtime}_wall} + ${lower_wall}) / 2")
      endif()
      set(${runtime}_checksum "${checksum}")
    endforeach()
    if(NOT upstream_checksum STREQUAL luthrum_checksum)
      message(FATAL_ERROR "Benchmark result differs between upstream and Luthrum")
    endif()
    ratio("${luthrum_cpu}" "${upstream_cpu}" cpu_ratio)
    ratio("${luthrum_wall}" "${upstream_wall}" wall_ratio)
    set(row "${workload},${collector},${repetitions},${samples},${upstream_cpu},${luthrum_cpu},${cpu_ratio},${upstream_wall},${luthrum_wall},${wall_ratio}")
    file(APPEND "${summary}" "${row}\n")
    message(STATUS "${row}")
  endforeach()
endforeach()
message(STATUS "Ratios are Luthrum/upstream; values above 1 mean slower. Raw: ${raw}; medians: ${summary}")
