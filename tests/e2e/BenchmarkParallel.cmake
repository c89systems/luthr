include("${CMAKE_CURRENT_LIST_DIR}/BenchmarkStats.cmake")
foreach(setting IN ITEMS samples warmups work_divisor tasks)
  if(NOT DEFINED ${setting})
    if(setting STREQUAL "samples")
      set(${setting} 5)
    elseif(setting STREQUAL "warmups")
      set(${setting} 2)
    elseif(setting STREQUAL "tasks")
      set(${setting} 32)
    else()
      set(${setting} 1)
    endif()
  endif()
endforeach()
if(NOT samples MATCHES "^[1-9][0-9]*$" OR NOT warmups MATCHES "^[0-9]+$"
    OR NOT tasks MATCHES "^[1-9][0-9]*$" OR NOT work_divisor MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "Invalid parallel benchmark settings")
endif()
execute_process(COMMAND "${luthr}" --capacity RESULT_VARIABLE result
  OUTPUT_VARIABLE capacity ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result EQUAL 0 OR NOT error STREQUAL "")
  message(FATAL_ERROR "Cannot read benchmark CPU capacity: ${result}: ${error}")
endif()
foreach(key IN ITEMS affinity_count quota_status quota_us period_us effective_cpu_milli)
  string(JSON capacity_${key} GET "${capacity}" "${key}")
endforeach()
if(NOT DEFINED levels)
  set(limit 1)
  if(NOT capacity_quota_status STREQUAL "unknown")
    math(EXPR limit "(${capacity_effective_cpu_milli} + 999) / 1000")
    if(limit LESS 1)
      set(limit 1)
    endif()
  endif()
  if(limit GREATER 64)
    set(limit 64)
  endif()
  if(limit GREATER tasks)
    set(limit "${tasks}")
  endif()
  set(levels 1)
  set(width 2)
  while(width LESS_EQUAL limit)
    list(APPEND levels "${width}")
    math(EXPR width "${width} * 2")
  endwhile()
  list(APPEND levels "${limit}")
endif()
list(REMOVE_DUPLICATES levels)
list(SORT levels COMPARE NATURAL)
list(GET levels 0 first)
if(NOT first STREQUAL "1")
  message(FATAL_ERROR "Worker levels must include 1 for the scaling baseline")
endif()
foreach(width IN LISTS levels)
  if(NOT width MATCHES "^[1-9][0-9]*$" OR width GREATER 64 OR width GREATER tasks)
    message(FATAL_ERROR "Worker count must be 1..min(tasks,64): ${width}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${output_dir}")
set(metrics checksum cpu_ns wall_ns service_p50_ns service_p95_ns latency_p50_ns
  latency_p95_ns latency_max_ns lua_live_bytes lua_peak_bytes lua_retained_bytes
  rss_hwm_kib carrier_stack_bytes carrier_guard_bytes dispatches affinity_count
  quota_us period_us effective_cpu_milli)
string(JOIN "," metric_header ${metrics})
file(WRITE "${output_dir}/samples.csv"
  "runtime,workload,collector,workers,tasks,iterations,sample,${metric_header},quota_status\n")
file(WRITE "${output_dir}/summary.csv"
  "workload,collector,workers,tasks,iterations,samples,${metric_header},upstream_wall_ns,wall_ratio,scaling_speedup\n")
string(TIMESTAMP started "%Y-%m-%dT%H:%M:%SZ" UTC)
set(metadata "{}")
foreach(key IN ITEMS target config compiler started)
  string(REPLACE "\\" "\\\\" value "${${key}}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(JSON metadata SET "${metadata}" "${key}" "\"${value}\"")
endforeach()
string(JSON metadata SET "${metadata}" lua "\"5.5.1\"")
string(JSON metadata SET "${metadata}" model "\"shared_vm_host_pool\"")
string(JSON metadata SET "${metadata}" timing_unit "\"ns\"")
string(JSON metadata SET "${metadata}" timing
  "\"CPU/wall includes coroutine cleanup, validation and final collection; service and completion latency cover execution.\"")
string(JSON metadata SET "${metadata}" ratio "\"luthr/upstream\"")
string(JSON metadata SET "${metadata}" capacity "${capacity}")
foreach(key IN ITEMS samples warmups tasks work_divisor)
  string(JSON metadata SET "${metadata}" "${key}" "${${key}}")
endforeach()
string(JOIN "," widths ${levels})
string(JSON metadata SET "${metadata}" workers "[${widths}]")
foreach(input IN ITEMS script upstream luthr library)
  file(SHA256 "${${input}}" digest)
  string(JSON metadata SET "${metadata}" "${input}_sha256" "\"${digest}\"")
endforeach()
execute_process(COMMAND git -C "${source_dir}" rev-parse HEAD
  RESULT_VARIABLE result OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot identify benchmark source revision")
endif()
string(JSON metadata SET "${metadata}" git_head "\"${head}\"")
execute_process(COMMAND git -C "${source_dir}" status --porcelain
  RESULT_VARIABLE result OUTPUT_VARIABLE dirty)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot identify benchmark worktree state")
endif()
if(dirty STREQUAL "")
  set(dirty false)
else()
  set(dirty true)
endif()
string(JSON metadata SET "${metadata}" git_dirty "${dirty}")
file(WRITE "${output_dir}/metadata.json" "${metadata}\n")
set(integers_iterations 500000)
set(independent_tables_iterations 5000)
set(shared_table_iterations 10000)
set(shared_reads_iterations 500000)
set(closures_iterations 50000)
set(allocation_gc_iterations 5000)
foreach(workload IN ITEMS integers independent_tables shared_table shared_reads closures allocation_gc)
  math(EXPR iterations "${${workload}_iterations} / ${work_divisor}")
  if(iterations LESS 1)
    set(iterations 1)
  endif()
  foreach(collector IN ITEMS incremental generational)
    set(reference_checksum "")
    foreach(runtime IN ITEMS upstream luthr)
      if(runtime STREQUAL "upstream")
        set(widths 1)
      else()
        set(widths ${levels})
      endif()
      foreach(width IN LISTS widths)
        execute_process(COMMAND "${${runtime}}" "${script}" "${workload}" "${collector}"
          "${width}" "${tasks}" "${iterations}" "${samples}" "${warmups}"
          RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0 OR NOT error STREQUAL "")
          message(FATAL_ERROR "Benchmark failed: ${runtime}/${workload}/${collector}/${width}: ${result}\n${output}${error}")
        endif()
        string(STRIP "${output}" output)
        string(REPLACE "\n" ";" rows "${output}")
        list(LENGTH rows count)
        if(NOT count EQUAL samples)
          message(FATAL_ERROR "Expected ${samples} samples, received ${count}")
        endif()
        foreach(metric IN LISTS metrics)
          set(values_${metric})
        endforeach()
        set(index 0)
        foreach(row IN LISTS rows)
          math(EXPR index "${index} + 1")
          string(REPLACE "," ";" fields "${row}")
          list(LENGTH fields count)
          if(NOT count EQUAL 21)
            message(FATAL_ERROR "Malformed benchmark row: ${row}")
          endif()
          foreach(field RANGE 0 19)
            list(GET fields ${field} value)
            if(NOT value MATCHES "^[0-9]+$")
              message(FATAL_ERROR "Non-numeric benchmark field: ${row}")
            endif()
          endforeach()
          list(GET fields 0 sample)
          if(NOT sample EQUAL index)
            message(FATAL_ERROR "Out-of-order benchmark sample: ${row}")
          endif()
          set(field 1)
          foreach(metric IN LISTS metrics)
            list(GET fields ${field} ${metric})
            list(APPEND values_${metric} "${${metric}}")
            math(EXPR field "${field} + 1")
          endforeach()
          list(GET fields 20 quota_status)
          if(reference_checksum STREQUAL "")
            set(reference_checksum "${checksum}")
          endif()
          if(NOT checksum STREQUAL reference_checksum OR NOT dispatches EQUAL tasks
              OR lua_peak_bytes LESS lua_live_bytes OR service_p95_ns LESS service_p50_ns
              OR latency_p95_ns LESS latency_p50_ns OR latency_max_ns LESS latency_p95_ns
              OR latency_max_ns GREATER wall_ns)
            message(FATAL_ERROR "Benchmark result or metric invariant failed: ${row}")
          endif()
          foreach(key IN ITEMS affinity_count quota_us period_us effective_cpu_milli quota_status)
            set(expected "${capacity_${key}}")
            if(key STREQUAL "effective_cpu_milli" AND capacity_quota_status STREQUAL "unknown")
              set(expected 0)
            endif()
            if(NOT "${${key}}" STREQUAL "${expected}")
              message(FATAL_ERROR "Benchmark CPU capacity changed for ${key}")
            endif()
          endforeach()
          file(APPEND "${output_dir}/samples.csv"
            "${runtime},${workload},${collector},${width},${tasks},${iterations},${row}\n")
        endforeach()
        set(medians)
        foreach(metric IN LISTS metrics)
          benchmark_median("${values_${metric}}" median_${metric})
          list(APPEND medians "${median_${metric}}")
        endforeach()
        if(runtime STREQUAL "upstream")
          set(reference_wall "${median_wall_ns}")
        else()
          if(width EQUAL 1)
            set(serial_wall "${median_wall_ns}")
          endif()
          benchmark_ratio("${median_wall_ns}" "${reference_wall}" wall_ratio)
          benchmark_ratio("${serial_wall}" "${median_wall_ns}" speedup)
          string(JOIN "," medians ${medians})
          set(summary "${workload},${collector},${width},${tasks},${iterations},${samples},${medians},${reference_wall},${wall_ratio},${speedup}")
          file(APPEND "${output_dir}/summary.csv" "${summary}\n")
          message(STATUS "${workload}/${collector}: workers=${width}, wall/upstream=${wall_ratio}, scaling=${speedup}")
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
message(STATUS "Host-pool measurements saved under ${output_dir}; scheduler compensation is not measured.")
