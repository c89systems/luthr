include("${CMAKE_CURRENT_LIST_DIR}/BenchmarkLua.cmake")
file(WRITE "${output_dir}/host.lua"
  "assert(arg[1]=='host-argument'); local t={}; for i=1,64 do t['field-'..i]=i end; for k in pairs(t) do print(k) end\n")
set(reference_order "")
foreach(runtime IN ITEMS upstream luthr)
  foreach(repetition RANGE 1 2)
    execute_process(COMMAND "${${runtime}}" "${output_dir}/host.lua" host-argument
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result STREQUAL "0" OR NOT error STREQUAL "" OR output STREQUAL "")
      message(FATAL_ERROR "Benchmark host arguments failed: ${runtime}: ${result}: ${error}")
    endif()
    if(reference_order STREQUAL "")
      set(reference_order "${output}")
    elseif(NOT output STREQUAL reference_order)
      message(FATAL_ERROR "Benchmark hosts used different table layouts: ${runtime}")
    endif()
  endforeach()
  execute_process(COMMAND "${${runtime}}" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result STREQUAL "0" OR NOT error MATCHES "usage: benchmark_host")
    message(FATAL_ERROR "Benchmark host accepted a missing script: ${runtime}")
  endif()
  execute_process(COMMAND "${${runtime}}" "${output_dir}/host.lua" wrong-argument
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result STREQUAL "0" OR NOT error MATCHES "assertion failed")
    message(FATAL_ERROR "Benchmark host lost a Lua failure: ${runtime}")
  endif()
endforeach()
file(WRITE "${output_dir}/drain.lua"
  "package.cpath=arg[1]..'/?.so'; local native=require('compat_fixture'); local clock=native.monotonic; local gc=collectgarbage; local active=false; local collections=0; collectgarbage=function(...) collections=collections+1; return gc(...) end; native.monotonic=function() if active then assert(collections>0,'sample ended before final collection'); active=false else collections=0; active=true end; return clock() end; dofile([=[${script}]=])\n")
foreach(runtime IN ITEMS upstream luthr)
  execute_process(COMMAND "${${runtime}}" "${output_dir}/drain.lua"
    "${module_dir}" integers incremental 1 0 100000 1
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result STREQUAL "0" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Final collection escaped the sample timer: ${runtime}: ${result}: ${output}${error}")
  endif()
endforeach()
file(STRINGS "${output_dir}/samples.csv" rows)
list(LENGTH rows raw_count)
math(EXPR expected_raw "7 * 2 * 2 * ${samples} + 1")
file(STRINGS "${output_dir}/summary.csv" summaries)
list(LENGTH summaries summary_count)
if(NOT raw_count EQUAL expected_raw OR NOT summary_count EQUAL 15)
  message(FATAL_ERROR "Benchmark did not save every sample and workload summary")
endif()
list(GET summaries 0 header)
if(NOT header STREQUAL "workload,collector,repetitions,samples,upstream_cpu_ns,luthr_cpu_ns,cpu_ratio,upstream_wall_ns,luthr_wall_ns,wall_ratio")
  message(FATAL_ERROR "Benchmark summary columns changed")
endif()
file(READ "${output_dir}/metadata.json" metadata)
foreach(key IN ITEMS lua target config compiler samples warmups work_divisor hash_seed ratio timing_unit)
  string(JSON actual GET "${metadata}" "${key}")
  if(key STREQUAL "lua")
    set(expected "5.5.1")
  elseif(key STREQUAL "ratio")
    set(expected "luthr/upstream")
  elseif(key STREQUAL "timing_unit")
    set(expected "ns")
  elseif(key STREQUAL "hash_seed")
    set(expected 0)
  else()
    set(expected "${${key}}")
  endif()
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Benchmark metadata differs for ${key}: ${actual} vs ${expected}")
  endif()
endforeach()
file(READ "${output_dir}/comparison.txt" comparison)
if(NOT comparison MATCHES "Single-worker wall time: Luthr / upstream Lua 5.5.1" OR
    NOT comparison MATCHES "larger values mean Luthr takes longer" OR
    NOT comparison MATCHES "${target} ${config}; ${samples} measured samples")
  message(FATAL_ERROR "Benchmark comparison omits its reference, configuration or ratio meaning")
endif()
list(REMOVE_AT summaries 0)
foreach(row IN LISTS summaries)
  string(REPLACE "," ";" fields "${row}")
  list(GET fields 0 workload)
  list(GET fields 1 collector)
  list(GET fields 9 ratio)
  set(expected_${workload}_${collector} "${ratio}")
endforeach()
foreach(workload IN ITEMS integers tables closures strings allocation_gc native_callbacks streaming)
  string(REPLACE "." "\\." incremental "${expected_${workload}_incremental}")
  string(REPLACE "." "\\." generational "${expected_${workload}_generational}")
  if(NOT comparison MATCHES "${workload} +${incremental}x +${generational}x\n")
    message(FATAL_ERROR "Comparison differs from measured medians for ${workload}")
  endif()
endforeach()
