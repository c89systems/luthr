include("${CMAKE_CURRENT_LIST_DIR}/BenchmarkStats.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/LuaApplications.cmake")
foreach(setting IN ITEMS samples warmups tasks work_divisor delay_us)
  if(NOT DEFINED ${setting})
    if(setting STREQUAL "samples")
      set(${setting} 5)
    elseif(setting STREQUAL "warmups")
      set(${setting} 2)
    elseif(setting STREQUAL "tasks")
      set(${setting} 32)
    elseif(setting STREQUAL "delay_us")
      set(${setting} 5000)
    else()
      set(${setting} 1)
    endif()
  endif()
  if(NOT "${${setting}}" MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid scheduler benchmark ${setting}")
  endif()
endforeach()
if(NOT DEFINED hash_seed)
  set(hash_seed 0)
endif()
if(NOT hash_seed MATCHES "^(0|[1-9][0-9]*)$" OR hash_seed GREATER 4294967295)
  message(FATAL_ERROR "Scheduler benchmark hash_seed must be an unsigned 32-bit integer")
endif()
if(samples LESS 1 OR samples GREATER 1000 OR warmups GREATER 1000 OR
    tasks LESS 1 OR tasks GREATER 4096 OR work_divisor LESS 1 OR
    delay_us LESS 1 OR delay_us GREATER 1000000)
  message(FATAL_ERROR "Scheduler benchmark settings outside supported bounds")
endif()
execute_process(COMMAND "${luthr}" --capacity RESULT_VARIABLE result
  OUTPUT_VARIABLE capacity ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result STREQUAL "0" OR NOT error STREQUAL "")
  message(FATAL_ERROR "Cannot read scheduler benchmark capacity: ${result}: ${error}")
endif()
string(JSON affinity GET "${capacity}" affinity_count)
string(JSON effective GET "${capacity}" effective_cpu_milli)
if(NOT DEFINED levels)
  if(effective GREATER 0)
    math(EXPR limit "(${effective} + 999) / 1000")
  else()
    set(limit "${affinity}")
  endif()
  foreach(bound IN ITEMS 8 "${tasks}")
    if(limit GREATER bound)
      set(limit "${bound}")
    endif()
  endforeach()
  set(levels 1)
  set(width 2)
  while(width LESS_EQUAL limit)
    list(APPEND levels "${width}")
    math(EXPR width "${width} * 2")
  endwhile()
  list(APPEND levels "${limit}" 0)
endif()
list(REMOVE_DUPLICATES levels)
foreach(width IN LISTS levels)
  if(NOT width MATCHES "^[0-9]+$" OR width GREATER 64)
    message(FATAL_ERROR "Scheduler benchmark slots must be 0..64: ${width}")
  endif()
endforeach()
if(NOT 1 IN_LIST levels)
  message(FATAL_ERROR "Scheduler benchmark levels must include 1")
endif()
set(automatic FALSE)
if(0 IN_LIST levels)
  set(automatic TRUE)
endif()
list(REMOVE_ITEM levels 0)
list(SORT levels COMPARE NATURAL)
if(automatic)
  list(APPEND levels 0)
endif()

set(metrics checksum cpu_ns wall_ns execution_cpu_ns execution_wall_ns
  cleanup_cpu_ns cleanup_wall_ns validation_cpu_ns validation_wall_ns
  completion_p50_ns completion_p95_ns
  completion_max_ns lua_live_bytes lua_retained_bytes rss_kib
  rss_hwm_kib threads parallelism carrier_limit native_limit observed_native_peak
  completed affinity_count quota_us period_us effective_cpu_milli)
file(MAKE_DIRECTORY "${output_dir}")
string(JOIN "," columns ${metrics})
set(keys "runtime,workload,collector,slots_requested,native_requested,tasks,iterations,delay_us")
file(WRITE "${output_dir}/samples.csv" "${keys},sample,${columns},quota_status\n")
file(WRITE "${output_dir}/summary.csv"
  "${keys},samples,${columns},upstream_wall_ns,wall_ratio,scaling_speedup\n")
set(metadata "{}")
string(TIMESTAMP started "%Y-%m-%dT%H:%M:%SZ" UTC)
foreach(key IN ITEMS target config compiler started)
  string(JSON metadata SET "${metadata}" "${key}" "\"${${key}}\"")
endforeach()
string(JSON metadata SET "${metadata}" model "\"public_task_scheduler\"")
string(JSON metadata SET "${metadata}" upstream_model "\"serial_coroutines\"")
string(JSON metadata SET "${metadata}" embedded_model "\"serial_coroutines\"")
string(JSON metadata SET "${metadata}" allocator "\"default\"")
string(JSON metadata SET "${metadata}" memory
  "\"Lua live and retained bytes are measured before post-run validation. RSS high-water is the process peak up to the sample's memory observation.\"")
string(JSON metadata SET "${metadata}" latency "\"host_observed_completion\"")
string(JSON metadata SET "${metadata}" timing
  "\"Total CPU/wall includes task cleanup and final collection. The validation fields time the post-run correctness check separately. Completion latency covers execution.\"")
string(JSON metadata SET "${metadata}" capacity "${capacity}")
foreach(key IN ITEMS samples warmups tasks work_divisor delay_us hash_seed)
  string(JSON metadata SET "${metadata}" "${key}" "${${key}}")
endforeach()
string(JOIN "," requested ${levels})
string(JSON metadata SET "${metadata}" levels "[${requested}]")
if(sanitizer)
  string(JSON metadata SET "${metadata}" thread_sanitizer true)
else()
  string(JSON metadata SET "${metadata}" thread_sanitizer false)
endif()
foreach(input IN ITEMS upstream luthr embedded library script)
  file(SHA256 "${${input}}" digest)
  string(JSON metadata SET "${metadata}" "${input}_sha256" "\"${digest}\"")
endforeach()
foreach(application IN LISTS lua_applications)
  file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/apps/${application}.lua" digest)
  string(JSON metadata SET "${metadata}" "${application}_sha256" "\"${digest}\"")
endforeach()
execute_process(COMMAND git -C "${source_dir}" rev-parse HEAD
  RESULT_VARIABLE result OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Cannot identify scheduler benchmark revision")
endif()
string(JSON metadata SET "${metadata}" git_head "\"${head}\"")
execute_process(COMMAND git -C "${source_dir}" status --porcelain
  RESULT_VARIABLE result OUTPUT_VARIABLE dirty)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Cannot identify scheduler benchmark worktree state")
endif()
if(dirty STREQUAL "")
  string(JSON metadata SET "${metadata}" git_dirty false)
else()
  string(JSON metadata SET "${metadata}" git_dirty true)
endif()
file(WRITE "${output_dir}/metadata.json" "${metadata}\n")

function(scheduled_measure runtime slots native delay)
  execute_process(COMMAND "${${runtime}}" "${work_script}" "${workload}" "${collector}"
    "${slots}" "${native}" "${tasks}" "${iterations}" "${samples}" "${warmups}" "${delay}"
    default-allocator "hash-seed=${hash_seed}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result STREQUAL "0" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Scheduler benchmark failed: ${runtime}/${workload}/${collector}/${slots}/${native}/${delay}: ${result}\n${output}${error}")
  endif()
  string(STRIP "${output}" output)
  string(REPLACE "\n" ";" rows "${output}")
  list(LENGTH rows count)
  if(NOT count EQUAL samples)
    message(FATAL_ERROR "Scheduler benchmark returned ${count} rows, expected ${samples}")
  endif()
  foreach(metric IN LISTS metrics)
    set(values_${metric})
  endforeach()
  set(index 0)
  foreach(row IN LISTS rows)
    math(EXPR index "${index} + 1")
    string(JSON sample GET "${row}" sample)
    if(NOT sample EQUAL index)
      message(FATAL_ERROR "Out-of-order scheduler benchmark sample")
    endif()
    string(JSON allocator GET "${row}" allocator)
    string(JSON heap_peak TYPE "${row}" lua_peak_bytes)
    if(NOT allocator STREQUAL "default" OR NOT heap_peak STREQUAL "NULL")
      message(FATAL_ERROR "Scheduler benchmark used a counting allocator: ${row}")
    endif()
    string(JSON observed_seed GET "${row}" hash_seed)
    if(NOT observed_seed EQUAL hash_seed)
      message(FATAL_ERROR "Scheduler benchmark used a different hash seed: ${row}")
    endif()
    set(values)
    foreach(metric IN LISTS metrics)
      string(JSON ${metric} GET "${row}" "${metric}")
      if(NOT "${${metric}}" MATCHES "^[0-9]+$")
        message(FATAL_ERROR "Invalid scheduler metric: ${metric}: ${row}")
      endif()
      list(APPEND values_${metric} "${${metric}}")
      list(APPEND values "${${metric}}")
    endforeach()
    if(reference_checksum STREQUAL "")
      set(reference_checksum "${checksum}")
    endif()
    math(EXPR measured_wall "${execution_wall_ns} + ${cleanup_wall_ns}")
    math(EXPR measured_cpu "${execution_cpu_ns} + ${cleanup_cpu_ns}")
    if(NOT wall_ns EQUAL measured_wall OR NOT cpu_ns EQUAL measured_cpu OR
        NOT checksum STREQUAL reference_checksum OR NOT completed EQUAL tasks OR
        completion_p95_ns LESS completion_p50_ns OR
        completion_max_ns LESS completion_p95_ns OR completion_max_ns GREATER wall_ns OR
        observed_native_peak GREATER native_limit OR parallelism LESS 1)
      message(FATAL_ERROR "Scheduler benchmark metric invariant failed: ${row}")
    endif()
    if(runtime STREQUAL "luthr")
      if((slots GREATER 0 AND NOT parallelism EQUAL slots) OR
          (native GREATER 0 AND NOT native_limit EQUAL native))
        message(FATAL_ERROR "Scheduler ignored an explicit resource limit: ${row}")
      endif()
      math(EXPR expected_carriers "${parallelism} + ${native_limit}")
      if(NOT carrier_limit EQUAL expected_carriers)
        message(FATAL_ERROR "Scheduler carrier reservation mismatch: ${row}")
      endif()
    elseif(NOT parallelism EQUAL 1 OR NOT carrier_limit EQUAL 0 OR NOT native_limit EQUAL 0)
      message(FATAL_ERROR "Serial host reported scheduler capacity: ${row}")
    endif()
    foreach(key IN ITEMS affinity_count quota_us period_us effective_cpu_milli quota_status)
      string(JSON actual GET "${row}" "${key}")
      string(JSON expected GET "${capacity}" "${key}")
      if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "CPU capacity changed during scheduler measurement: ${key}")
      endif()
    endforeach()
    string(JSON quota_status GET "${row}" quota_status)
    string(JOIN "," values ${values})
    file(APPEND "${output_dir}/samples.csv"
      "${runtime},${workload},${collector},${slots},${native},${tasks},${iterations},${delay},${sample},${values},${quota_status}\n")
  endforeach()
  set(medians)
  foreach(metric IN LISTS metrics)
    benchmark_median("${values_${metric}}" median)
    list(APPEND medians "${median}")
    set(median_${metric} "${median}" PARENT_SCOPE)
  endforeach()
  set(reference_checksum "${reference_checksum}" PARENT_SCOPE)
  string(JOIN "," medians ${medians})
  set(medians "${medians}" PARENT_SCOPE)
endfunction()

set(integers_iterations 500000)
set(independent_tables_iterations 5000)
set(mixed_records_iterations 25000)
set(shared_table_iterations 10000)
set(shared_hash_iterations 10000)
set(shared_growth_iterations 2500)
set(shared_array_growth_iterations 2500)
set(shared_sparse_growth_iterations 2500)
set(shared_reads_iterations 500000)
set(closures_iterations 50000)
set(allocation_gc_iterations 5000)
set(callback_workloads lua_callback native_callbacks native_callbacks_local native_direct
  native_direct_local native_leaf native_stack native_identity
  native_scalar native_scalar_direct native_protected native_records native_streaming)
set(embedded_workloads mixed_records ${callback_workloads} ${lua_applications})
foreach(workload IN LISTS callback_workloads)
  set(${workload}_iterations 18000)
endforeach()
set(native_streaming_iterations 6000)
set(native_records_iterations 6000)
foreach(workload IN ITEMS integers independent_tables mixed_records shared_table shared_hash
    shared_growth shared_array_growth shared_sparse_growth shared_reads closures
    allocation_gc ${callback_workloads} ${lua_applications})
  set(work_script "${script}")
  set(delays 0 "${delay_us}")
  if(workload IN_LIST lua_applications)
    set(work_script "${CMAKE_CURRENT_LIST_DIR}/apps/${workload}.lua")
    set(delays 0)
  endif()
  math(EXPR iterations "${${workload}_iterations} / ${work_divisor}")
  if(iterations LESS 1)
    set(iterations 1)
  endif()
  set(reference_checksum "")
  foreach(collector IN ITEMS incremental generational)
    foreach(delay IN LISTS delays)
      scheduled_measure(upstream 1 0 "${delay}")
      set(reference_wall "${median_wall_ns}")
      file(APPEND "${output_dir}/summary.csv"
        "upstream,${workload},${collector},1,0,${tasks},${iterations},${delay},${samples},${medians},${reference_wall},1.000,1.000\n")
      if(workload IN_LIST embedded_workloads)
        scheduled_measure(embedded 1 0 "${delay}")
        benchmark_ratio("${median_wall_ns}" "${reference_wall}" ratio)
        file(APPEND "${output_dir}/summary.csv"
          "embedded,${workload},${collector},1,0,${tasks},${iterations},${delay},${samples},${medians},${reference_wall},${ratio},1.000\n")
        message(STATUS "${workload}/${collector}: embedded, delay=${delay}, wall/upstream=${ratio}")
      endif()
      if(delay EQUAL 0)
        set(native_limits 0)
      else()
        set(native_limits 0 1)
      endif()
      foreach(width IN LISTS levels)
        foreach(native IN LISTS native_limits)
          scheduled_measure(luthr "${width}" "${native}" "${delay}")
          if(width EQUAL 1)
            set(serial_${native} "${median_wall_ns}")
          endif()
          benchmark_ratio("${median_wall_ns}" "${reference_wall}" ratio)
          benchmark_ratio("${serial_${native}}" "${median_wall_ns}" speedup)
          file(APPEND "${output_dir}/summary.csv"
            "luthr,${workload},${collector},${width},${native},${tasks},${iterations},${delay},${samples},${medians},${reference_wall},${ratio},${speedup}\n")
          message(STATUS "${workload}/${collector}: slots=${width}, native=${native}, delay=${delay}, wall/upstream=${ratio}, scaling=${speedup}")
        endforeach()
      endforeach()
    endforeach()
  endforeach()
endforeach()
