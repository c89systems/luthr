file(REMOVE_RECURSE "${build_dir}/sdk")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${build_dir}"
  --prefix "${build_dir}/sdk" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "SDK installation failed: ${result}")
endif()
file(GLOB_RECURSE documents "${build_dir}/sdk/share/luthr/*.md")
foreach(document IN LISTS documents)
  file(READ "${document}" content)
  get_filename_component(parent "${document}" DIRECTORY)
  string(REPLACE "](" "__luthr_link__(" content "${content}")
  string(REGEX MATCHALL "__luthr_link__\\([^)\n]+\\)" links "${content}")
  foreach(link IN LISTS links)
    string(REGEX REPLACE "^__luthr_link__\\((.*)\\)$" "\\1" target "${link}")
    if(target MATCHES "^[a-z]+:" OR target MATCHES "^#")
      continue()
    endif()
    string(REGEX REPLACE "#.*$" "" target "${target}")
    if(NOT EXISTS "${parent}/${target}")
      message(FATAL_ERROR "Installed documentation link missing: ${document}: ${target}")
    endif()
  endforeach()
endforeach()
